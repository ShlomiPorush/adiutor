# Development-only values for the local and verify stacks. Not secrets: they guard nothing real and
# only ever bind to 127.0.0.1. Never use them in production.
POSTGRES_USER=mikud
POSTGRES_PASSWORD=dev-only-password
POSTGRES_DB=mikud
DATABASE_URL=postgres://mikud:dev-only-password@postgres:5432/mikud
MIKUD_AUTH_SECRETS=1:dev-only-auth-secret-not-a-secret-0000000
MIKUD_SETTINGS_KEYS=1:dev-only-settings-key-not-a-secret-000000
MIKUD_PUBLIC_URL=http://127.0.0.1:8090
