# Copy to .env next to docker-compose.yml and fill in. Example values only: never commit .env.
#
# Two kinds of variables live here. "Compose" variables are read by docker compose itself while it
# reads docker-compose.yml. "App" variables reach the server through env_file.

# --- Compose: deployment ---
# Image tag to run: the release being deployed, for example 0.1.0. No default on purpose, so an
# unset value fails instead of resolving to "latest".
VERSION=0.1.0
# Host name Traefik routes to Adiutor. Reachable only over the private network.
DOMAIN=adiutor.example.com

# --- App ---
# The owner's PostgreSQL: a database and role for Adiutor only. Migrations run on every start.
# Format: postgres://<role>:<a long random password>@<host>:5432/<database>
# Left empty on purpose: the server refuses to start until it is set.
DATABASE_URL=
# URL the owner opens. Browsers' Origin must equal it; links in Telegram messages use it.
ADIUTOR_PUBLIC_URL=https://${DOMAIN}
# Better Auth's versioned secrets: they sign the sign-in cookies and encrypt the TOTP secret and the backup
# codes. Format <version>:<secret>, newest first; each secret at least 32 random bytes (openssl rand -hex 32).
# To rotate, put a new version first and keep the old one listed: browsers sign in again, TOTP keeps working.
# Left empty on purpose: the server refuses to start until it is set.
ADIUTOR_AUTH_SECRETS=
# Encrypts the secrets stored in Settings (the Telegram bot token). Same format; must differ from every auth
# secret. A stored value whose version is no longer listed must be entered again in Settings.
ADIUTOR_SETTINGS_KEYS=
# The address or CIDR range Traefik uses to reach adiutor (the traefik network). Better Auth then reads the
# client address from X-Forwarded-For for its rate limits. Safe only while Adiutor is reachable through Traefik
# alone and Traefik replaces client forwarding headers (docs/deployment.md, step 3).
ADIUTOR_TRUSTED_PROXIES=
#
# Everything else is set in Adiutor, in Settings: the Telegram bot token and chat id, sign-in codes to Telegram,
# the private domains, the agent keys and how long a browser stays signed in. The three variables below may
# override a field instead; Settings then shows it locked. Leave them empty to manage them in Settings.
# Never set a BETTER_AUTH_* variable: the server refuses to start with one.
ADIUTOR_PRIVATE_DOMAINS=
ADIUTOR_TELEGRAM_BOT_TOKEN=
ADIUTOR_TELEGRAM_CHAT_ID=
# Only tests point this at a stand-in Bot API. Leave it empty in production.
TELEGRAM_API_URL=
