# Copy to .env next to docker-compose.yml and fill in. Example values only: never commit .env.
#
# Two kinds of variables live here. "Compose" variables are read by docker compose itself while it
# reads docker-compose.yml. "App" variables reach the server through env_file.

# --- Compose: deployment ---
# Image tag to run: the release being deployed, for example 0.1.0. No default on purpose, so an
# unset value fails instead of resolving to "latest".
VERSION=0.1.0
# Host name Traefik routes to Mikud. Reachable only over the private network.
DOMAIN=mikud.example.com

# --- App ---
# The owner's PostgreSQL: a database and role for Mikud only. Migrations run on every start.
DATABASE_URL=postgres://mikud:replace-with-a-long-random-password@db.example.com:5432/mikud
# URL the owner opens. Browsers' Origin must equal it; links in Telegram messages use it.
MIKUD_PUBLIC_URL=https://${DOMAIN}
# Two different tokens, each at least 32 characters. Generate each with: openssl rand -hex 32
# The owner token can do everything; give agents only the agent token. Left empty here on purpose:
# the server refuses to start until both are set.
MIKUD_OWNER_TOKEN=
MIKUD_AGENT_TOKEN=
# Signs the browser's sign-in cookies and encrypts the TOTP secret. At least 32 random bytes, different from
# both tokens; generate it with: openssl rand -hex 32. Changing it signs every browser out and makes the stored
# TOTP secret unreadable (then reset with the recovery command in docs/deployment.md). Left empty on purpose:
# the server refuses to start until it is set.
MIKUD_AUTH_SECRET=
# Optional. Comma-separated domains whose host names agents must not write into Mikud, for example
# your private network's domain. Agent text naming a host under them is refused as a suspected secret.
MIKUD_PRIVATE_DOMAINS=
# Optional. The Telegram bot (quick add) and the 08:00 morning message. Both off until both are set; the
# server refuses to start with only one. The bot token comes from BotFather; the chat id is the owner's
# own chat with the bot (a number). The bot serves that chat only.
MIKUD_TELEGRAM_BOT_TOKEN=
MIKUD_TELEGRAM_CHAT_ID=
# Only tests point this at a stand-in Bot API. Leave it empty in production.
TELEGRAM_API_URL=
