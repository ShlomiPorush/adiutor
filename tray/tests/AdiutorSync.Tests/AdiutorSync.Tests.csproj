<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit tests of the tray's logic with a fake engine and fake time, and of the engine runner and its Job Object
       with a stand-in engine script run by node. No real T3, Adiutor or profile: every folder is a new temporary one. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test names read as sentences, with underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Globalization" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdiutorSync.Core\AdiutorSync.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
